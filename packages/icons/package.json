{
  "name": "marshmallow-icons",
  "version": "0.3.1",
  "description": "Marshmallow UDS SVG icons as React components",
  "license": "UNLICENSED",
  "author": "The Don't Stop Brand Inc operating as Marshmallow Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayoelutilo/marshmallow-icons.git"
  },
  "keywords": [
    "icons",
    "react",
    "svg",
    "components",
    "marshmallow",
    "design-system"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icons-catalog.json": "./dist/icons-catalog.json",
    "./migration-map.json": "./dist/migration-map.json",
    "./tabler-compat-map.json": "./dist/tabler-compat-map.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "marshmallow-icons": "scripts/migrate-icons.mjs",
    "marshmallow-icons-migrate": "scripts/migrate-icons.mjs"
  },
  "files": [
    "AUDIT.md",
    "CATALOG.md",
    "LICENSE",
    "README.md",
    "TABLER_MIGRATION.md",
    "dist",
    "scripts/migrate-icons.mjs",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@tabler/icons-react": "3.35.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "generate": "node ./scripts/generate-icons.mjs",
    "build": "node ./scripts/build.mjs",
    "migrate": "node ./scripts/migrate-icons.mjs",
    "prepack": "npm run build"
  }
}
